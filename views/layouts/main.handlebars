<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Tienda</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: Arial, sans-serif; background: #f4f4f4; color: #333; padding: 20px; }
        h1 { margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; background: #fff; margin-bottom: 20px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background: #222; color: #fff; }
        nav { margin-bottom: 20px; background: #222; padding: 10px; border-radius: 5px; display: flex; align-items: center; gap: 15px; flex-wrap: wrap; }
        nav a { color: #fff; text-decoration: none; font-weight: bold; }
        nav a:hover { text-decoration: underline; color: #007bff; }
        form { background: #fff; padding: 20px; border-radius: 5px; max-width: 600px; margin-bottom: 20px; }
        form label { display: inline-block; margin-top: 10px; font-weight: bold; }
        form input, form select, form button { display: block; width: 100%; margin-bottom: 10px; padding: 8px; font-size: 14px; }
        form button { background: #28a745; color: #fff; border: none; cursor: pointer; }
        form button:hover { background: #218838; }
        .btn-delete { background: #dc3545; color: #fff; border: none; padding: 5px 10px; cursor: pointer; }
        .btn-delete:hover { background: #c82333; }
        .btn-edit { background: #ffc107; color: #333; border: none; padding: 5px 10px; cursor: pointer; margin-right: 5px; }
        .btn-edit:hover { background: #e0a800; }
        .btn-add-cart { background: #007bff; color: #fff; border: none; padding: 8px 16px; cursor: pointer; border-radius: 3px; }
        .btn-add-cart:hover { background: #0056b3; }
        .btn-detail { background: #17a2b8; color: #fff; padding: 8px 16px; text-decoration: none; border-radius: 3px; margin-right: 5px; }
        .btn-detail:hover { background: #138496; }
        .btn-back { background: #6c757d; color: #fff; padding: 8px 16px; text-decoration: none; border-radius: 3px; }
        .btn-back:hover { background: #5a6268; }
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; margin-bottom: 20px; }
        .product-card { background: #fff; padding: 15px; border-radius: 5px; border: 1px solid #ddd; }
        .product-card h3 { margin-bottom: 10px; color: #333; }
        .product-card p { margin-bottom: 5px; }
        .product-actions { margin-top: 15px; display: flex; gap: 10px; }
        .product-detail { background: #fff; padding: 20px; border-radius: 5px; max-width: 600px; }
        .product-detail .product-info p { margin-bottom: 10px; }
        .product-detail .product-actions { margin-top: 20px; display: flex; gap: 10px; }
        .pagination { display: flex; justify-content: center; align-items: center; gap: 20px; margin: 20px 0; }
        .page-link { background: #007bff; color: #fff; padding: 8px 16px; text-decoration: none; border-radius: 3px; }
        .page-link:hover { background: #0056b3; }
        .page-info { font-weight: bold; }
        .cart-total { font-size: 1.2em; margin: 20px 0; text-align: right; }
        .cart-actions { display: flex; gap: 10px; justify-content: flex-end; }
        .thumbnail-img { width: 80px; height: 80px; object-fit: cover; margin: 5px; border-radius: 3px; }
        .filters { background: #fff; padding: 15px; border-radius: 5px; margin-bottom: 20px; }
        .filters form { margin: 0; max-width: 100%; }
        .filters label { display: inline-block; margin-right: 10px; }
        .filters input, .filters select { display: inline-block; width: auto; margin-right: 10px; }
        .filters button { display: inline-block; width: auto; }
    </style>
</head>
<body>
    <nav>
        <a href="/">Inicio</a>
        <a href="/products">Productos</a>
        <a href="/realtimeproducts">Tiempo Real</a>
        <a href="#" id="cart-link">Mi Carrito</a>
    </nav>
    {{{body}}}

    <script>
        // Actualiza el link del carrito segun el ID guardado en localStorage
        (function() {
            const cartId = localStorage.getItem('cartId');
            const cartLink = document.getElementById('cart-link');
            if (cartId) {
                cartLink.href = '/carts/' + cartId;
            } else {
                cartLink.href = '/carts';
            }
        })();
    </script>
</body>
</html>
